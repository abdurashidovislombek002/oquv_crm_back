# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Asia/Tashkent
DJANGO_LANGUAGE_CODE=uz
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend (CORS) — frontend NEVER talks to PostgreSQL directly
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://crm.example.uz
CORS_ALLOW_CREDENTIALS=True
FRONTEND_BASE_URL=https://crm.example.uz

# ---------------------------------------------------------------------------
# PostgreSQL (only the backend container/server uses these credentials)
# ---------------------------------------------------------------------------
POSTGRES_DB=crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=strong_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://crm_user:strong_db_password@db:5432/crm
# Set to 1 to force SQLite (used by the test-suite on machines without Docker)
USE_SQLITE=0

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=0

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14
JWT_ROTATE_REFRESH_TOKENS=True

# ---------------------------------------------------------------------------
# Throttling
# ---------------------------------------------------------------------------
THROTTLE_ANON_RATE=20/min
THROTTLE_USER_RATE=600/min
THROTTLE_AUTH_RATE=10/min

# ---------------------------------------------------------------------------
# Notifications channels
# ---------------------------------------------------------------------------
DEFAULT_FROM_EMAIL=no-reply@crm.example.uz
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ESMS_API_URL=
ESMS_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_ID=
